    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "multer": "^2.0.2",
    "obscenity": "^0.4.6"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1"
  }
