<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="wrap page">
  <%- include('partials/flash') %>
  <h1>Audit log</h1>
  <p class="lede tight">Every moderator action is recorded here, including automatic hides after multiple reports and verification decisions.</p>
  <%- include('partials/mod-nav') %>

  <% if (!entries.length) { %>
    <div class="empty"><p>No moderation actions yet.</p></div>
  <% } else { %>
    <table class="audit-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Actor</th>
          <th>Action</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody>
        <% entries.forEach((entry) => { %>
          <tr>
            <td class="nowrap"><%= entry.created_at %></td>
            <td><%= entry.actor_name || 'System' %></td>
            <td><%= entry.action.replace(/_/g, ' ') %></td>
            <td>
              <% if (entry.target_name) { %><div>User: <%= entry.target_name %></div><% } %>
              <% if (entry.review_id) { %><div>Review #<%= entry.review_id %></div><% } %>
              <% if (entry.verification_id) { %><div>Verification #<%= entry.verification_id %></div><% } %>
              <% if (entry.details && typeof entry.details === 'object') { %>
                <div><%= entry.details.address || '' %> <%= entry.details.reason || entry.details.excerpt || entry.details.occupancy || '' %></div>
              <% } else if (entry.details) { %>
                <div><%= entry.details %></div>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>
<%- include('partials/footer') %>
